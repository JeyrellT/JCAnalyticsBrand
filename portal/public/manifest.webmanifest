    },
    {
      "name": "Agendar cita",
      "short_name": "Cita",
      "description": "Agendar una cita en la agenda",
      "url": "/agenda?nueva=1",
      "icons": [{ "src": "/icons/shortcut-cita-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Buzón",
      "short_name": "Buzón",
      "description": "Ver mis avisos y confirmaciones",
      "url": "/buzon",
      "icons": [{ "src": "/icons/shortcut-buzon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Registrar avance",
