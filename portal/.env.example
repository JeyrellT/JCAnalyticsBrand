# Portal JC Analytics — variables del servidor (nunca en el repositorio con valores reales).
NODE_ENV=production
PORT=3002
# Archivo SQLite. En Railway: dentro del volumen montado en /data.
PORTAL_DB_PATH=/data/portal.sqlite
# Solo para crear el primer administrador cuando la base está vacía. Borrar tras el primer ingreso.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_NAME=
PORTAL_ADMIN_PASSWORD=
# Opcional: orígenes extra permitidos para escrituras (separados por coma).
PORTAL_ALLOWED_ORIGINS=
# Opcional: 1 para registrar cada solicitud en los logs (sin cuerpos ni datos personales).
PORTAL_LOG_REQUESTS=0
# ── v3: avisos push y automatizaciones ──────────────────────────────────────
# Claves VAPID en base64url (pública sin comprimir de 65 bytes; privada = escalar d de 32 bytes).
# Opcionales: si faltan, el servidor las genera una vez y las guarda en la base (tabla app_secrets).
# Definirlas en Railway permite conservar las suscripciones aunque se recree la base.
PORTAL_VAPID_PUBLIC_KEY=
PORTAL_VAPID_PRIVATE_KEY=
# Contacto VAPID que ven los servicios de push (por defecto mailto:gerencia@jcanalytic.com).
PORTAL_VAPID_SUBJECT=
# Opcional: API del tipo de cambio (por defecto https://api.hacienda.go.cr/indicadores/tc/dolar).
PORTAL_FX_URL=
# 0 para apagar el programador de automatizaciones (corre cada 60 s). Vacío = encendido.
PORTAL_SCHEDULER=
