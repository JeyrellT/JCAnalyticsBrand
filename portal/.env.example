# Portal JC Analytics — variables del servidor (nunca en el repositorio con valores reales).
NODE_ENV=production
PORT=3002
# Archivo SQLite. En Railway: dentro del volumen montado en /data.
PORTAL_DB_PATH=/data/portal.sqlite
# Solo para crear el primer administrador cuando la base está vacía. Borrar tras el primer ingreso.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_NAME=
PORTAL_ADMIN_PASSWORD=
# Opcional: orígenes extra permitidos para escrituras (separados por coma).
PORTAL_ALLOWED_ORIGINS=
# Opcional: 1 para registrar cada solicitud en los logs (sin cuerpos ni datos personales).
PORTAL_LOG_REQUESTS=0
